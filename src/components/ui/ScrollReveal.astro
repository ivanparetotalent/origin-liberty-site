---
interface Props {
  as?: 'div' | 'section' | 'article' | 'li' | 'header' | 'footer';
  stagger?: boolean;
  class?: string;
  delay?: number;
}
const { as: Tag = 'div', stagger = false, class: className = '', delay = 0 } = Astro.props;
const styleAttr = delay ? `transition-delay: ${delay}ms;` : undefined;
---

<Tag
  class={`reveal ${stagger ? 'reveal-stagger' : ''} ${className}`.trim()}
  data-reveal
  style={styleAttr}
>
  <slot />
</Tag>

<!-- Init script lives in Layout.astro <head> so it runs once, early. -->
