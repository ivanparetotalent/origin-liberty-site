---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../ui/SectionHeader.astro';
import ScrollReveal from '../ui/ScrollReveal.astro';

/**
 * "What you get" — editorial vertical numbered list (was a 10-card grid).
 * Aman / Loro Piana cadence: large display numerals + bold headline +
 * always-visible body. No hover tricks. Subtle hairline rules between
 * items. Two ScrollReveal staggers split into halves so the cascade
 * stays graceful when the section enters the viewport.
 */

interface Item {
  num: string;
  title: string;
  body: string;
  highlight?: string;
}

const items: Item[] = [
  {
    num: '01',
    title: 'A 30-minute discovery call. With me.',
    body: "Not a salesperson. Free. By the end I tell you one of three things: yes and we should do it; yes Uruguay but you're six months early; or no this isn't right and here's what might be.",
  },
  {
    num: '02',
    title: 'A 20-page Move Plan. In writing. In 48 hours.',
    body: 'Tax sequence. Neighborhood selection. School shortlist. Banking partner. 90-day timeline. Yours to keep regardless of whether you sign with us.',
  },
  {
    num: '03',
    title: 'Full Uruguay residency filing.',
    body: "Top-tier immigration firm. Document prep, translations, follow-ups. Your *cédula* (national ID) issued during the 90-day window. Full permanent residency follows in 6–8 months. Family of two included.",
  },
  {
    num: '04',
    title: 'U.S. tax structuring with a vetted CPA.',
    body: 'Pre-move planning. Entity structure, GILTI, FEIE, distribution timing, exit-event sequencing. The single highest-leverage line in the package — and the one most relocation services skip entirely.',
  },
  {
    num: '05',
    title: 'A dedicated Spanish-speaking EA. Six months embedded.',
    body: "They open your bank account. Register your healthcare. Enroll your kids. Get your driver's license. Negotiate with the electric company, the broker, the woman at DGI who asks for one more form.",
    highlight: 'You never make a Spanish-language phone call.',
  },
  {
    num: '06',
    title: 'Apartment sourced, leased, furnished.',
    body: 'We pick the neighborhood — Pocitos, Carrasco, or Punta Carretas — based on your family. Negotiate the lease in Spanish. Handle the deposit. Furnish it for six months. You walk into a finished home.',
  },
  {
    num: '07',
    title: 'The founder onboarding weekend.',
    body: 'Your first weekend in country, my wife and I host you. Asado at our place. Walk through Pocitos. Intros to other relocated founders. The five things I wish someone had told me on day one.',
  },
];

// Inline italic for *cédula* etc.
function renderEmphasized(input: string) {
  const parts = input.split(/(\*[^*]+\*)/g);
  return parts
    .map((p) =>
      p.startsWith('*') && p.endsWith('*')
        ? `<em class="italic text-ink">${p.slice(1, -1)}</em>`
        : p
    )
    .join('');
}
---

<section id="offer" class="section-y bg-bone">
  <div class="container-edge">
    <ScrollReveal class="mx-auto max-w-3xl">
      <SectionHeader
        eyebrow="What you get"
        title="One coordinator. Ninety days. Everything done."
        subhead="Ninety days from your signature to your family on the ground in Montevideo, residency filed, apartment furnished, kids enrolled, business uninterrupted. You make decisions. We execute."
      />
    </ScrollReveal>

    <ol class="mx-auto mt-16 flex max-w-4xl flex-col">
      {items.map((item, i) => (
        <ScrollReveal>
          <li
            class={`grid grid-cols-1 gap-6 border-border-soft py-10 md:grid-cols-12 md:gap-10 md:py-12 ${
              i > 0 ? 'border-t' : ''
            }`}
          >
            <div class="md:col-span-3">
              <span
                class="font-display text-[3rem] leading-none text-oxblood md:text-[3.6rem]"
                style="font-variation-settings: 'opsz' 144, 'wght' 320; letter-spacing: -0.02em;"
              >
                {item.num}
              </span>
            </div>
            <div class="flex flex-col gap-3 md:col-span-9">
              <h3
                class="font-display text-[1.55rem] text-ink text-balance md:text-[1.85rem]"
                style="font-variation-settings: 'opsz' 96, 'wght' 420; line-height: 1.18;"
              >
                {item.title}
              </h3>
              <p
                class="text-[1rem] leading-relaxed text-ink-muted text-pretty md:text-[1.05rem]"
                set:html={renderEmphasized(item.body)}
              />
              {item.highlight && (
                <p class="mt-1 text-[1rem] font-medium text-ink md:text-[1.05rem]">
                  {item.highlight}
                </p>
              )}
            </div>
          </li>
        </ScrollReveal>
      ))}
    </ol>

    <ScrollReveal class="mx-auto mt-12 max-w-4xl rounded-2xl border border-border-soft bg-bone-deeper/40 p-7 md:p-9">
      <div class="flex flex-col gap-3 md:flex-row md:items-start md:gap-6">
        <span class="flex-none text-xs font-medium uppercase tracking-eyebrow text-brass-deep">
          Plus
        </span>
        <div class="flex flex-col gap-2 text-[0.98rem] leading-relaxed text-ink md:text-[1rem]">
          <p>
            <strong class="font-medium">24/7 WhatsApp support</strong> for six months. One thread. Your EA, me, the team. Anything that comes up.
          </p>
          <p>
            <strong class="font-medium">Permanent access to the Founder Network</strong> — private Slack of relocated U.S. founders, twice-yearly in-person dinners. You don't lose access at month six.
          </p>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>
