---
import BookingFormPlaceholder from '../BookingFormPlaceholder.astro';
import ScrollReveal from '../ui/ScrollReveal.astro';

interface Props {
  embedUrl?: string | null;
}
const { embedUrl = null } = Astro.props;
---

<section id="book" class="section-y bg-bone scroll-mt-24">
  <div class="container-edge">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">
      <ScrollReveal class="lg:col-span-5">
        <h2
          class="font-display text-ink text-balance"
          style="font-size: clamp(1.85rem, 3.6vw, 2.75rem); line-height: 1.1; font-variation-settings: 'opsz' 96, 'wght' 400;"
        >
          30 minutes. Free. With a founder who just did this.
        </h2>

        <div class="mt-6 flex flex-col gap-4 text-[1rem] leading-relaxed text-ink-muted md:text-[1.05rem]">
          <p>By the end of the call you will know:</p>
          <ul class="flex flex-col gap-2 pl-5">
            <li class="list-disc marker:text-brass">Whether Uruguay is right for you and your family</li>
            <li class="list-disc marker:text-brass">The U.S. tax sequence that protects your exit</li>
            <li class="list-disc marker:text-brass">What 90 days of execution would actually cost you</li>
            <li class="list-disc marker:text-brass">Whether to do this with us, alone, or not at all</li>
          </ul>
          <p class="mt-3 text-sm text-ink-soft">
            Eight slots in the inaugural cohort. June 1, 2026. Founder pricing $20,000.
          </p>
        </div>
      </ScrollReveal>

      <ScrollReveal class="lg:col-span-7">
        <BookingFormPlaceholder embedUrl={embedUrl} />
      </ScrollReveal>
    </div>
  </div>
</section>
