---
import { BOOKING } from '../lib/seo';

interface Props {
  embedUrl?: string | null;
  embedScript?: string | null;
  iframeId?: string;
  title?: string;
  minHeight?: number;
}

const {
  embedUrl = BOOKING.embedUrl,
  embedScript = BOOKING.embedScript,
  iframeId = BOOKING.iframeId,
  title = 'Book a discovery call',
  minHeight = 760,
} = Astro.props;
---

{embedUrl ? (
  <div
    class="overflow-hidden rounded-2xl border border-border-soft bg-bone-soft"
    data-lenis-prevent
  >
    <iframe
      src={embedUrl}
      title={title}
      id={iframeId}
      class="block w-full"
      style={`min-height: ${minHeight}px; border: 0;`}
      scrolling="no"
    ></iframe>
    {/*
      The form_embed.js script handles postMessage-based auto-resize.
      Loaded synchronously (no async/defer) and AFTER the iframe so it
      definitely sees the iframe element when it registers listeners.
      Matches the original LeadConnector embed snippet pattern.
    */}
    {embedScript && (
      <script is:inline src={embedScript} type="text/javascript"></script>
    )}
  </div>
) : (
  <div
    class="flex flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-border bg-bone-soft px-8 py-16 text-center"
  >
    <p class="font-display text-xl text-ink" style="font-variation-settings: 'opsz' 96, 'wght' 400;">
      Booking form will be embedded here.
    </p>
    <p class="text-sm text-ink-muted">
      In the meantime, email
      <a
        href="mailto:hello@originliberty.com"
        class="text-oxblood underline-offset-4 hover:underline"
      >
        hello@originliberty.com
      </a>.
    </p>
  </div>
)}
