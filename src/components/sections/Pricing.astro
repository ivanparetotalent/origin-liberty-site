---
import SectionHeader from '../ui/SectionHeader.astro';
import ScrollReveal from '../ui/ScrollReveal.astro';
import Card from '../ui/Card.astro';

const rows = [
  { item: 'Custom Move Plan', price: '$2,500' },
  { item: 'U.S. tax structure with CPA partner', price: '$5,000' },
  { item: 'Uruguay residency, family included', price: '$8,000' },
  { item: 'Apartment sourcing + lease negotiation', price: '$5,000' },
  { item: 'Furnished living, 6 months', price: '$4,500' },
  { item: 'Spanish-speaking embedded EA, 6 months', price: '$18,000' },
  { item: 'Founder onboarding weekend', price: '$1,500' },
  { item: 'Founder Network (lifetime)', price: '$2,500' },
  { item: '24/7 WhatsApp support, 6 months', price: '$1,500' },
  { item: 'Banking, healthcare, utilities, school setup', price: '$3,000' },
];
---

<section class="section-y bg-bone-deeper/30">
  <div class="container-edge">
    <ScrollReveal class="mx-auto max-w-[880px]">
      <div class="flex flex-col items-center text-center">
        <SectionHeader
          eyebrow="Investment"
          title="$20,000."
          subhead="Family up to four included. Each additional dependent: $3,500."
        />
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-muted md:text-[1.05rem]">
          This is the <strong class="font-medium text-ink">inaugural cohort price</strong>. Eight families. June 2026 cohort. After that, standard price moves to $35,000.
        </p>
      </div>
    </ScrollReveal>

    <ScrollReveal class="mx-auto mt-14 max-w-[880px]">
      <Card variant="soft" padding="none" class="overflow-hidden">
        <div class="px-6 py-6 md:px-10 md:py-8">
          <div class="flex items-baseline justify-between border-b border-border-soft pb-4">
            <h3 class="font-display text-xl text-ink" style="font-variation-settings: 'opsz' 96, 'wght' 420;">
              Component
            </h3>
            <p class="text-xs uppercase tracking-eyebrow text-ink-soft">
              What you'd pay alone
            </p>
          </div>

          <dl class="divide-y divide-border-soft">
            {rows.map((r) => (
              <div class="flex items-center justify-between gap-6 py-4">
                <dt class="text-[0.98rem] leading-snug text-ink-muted">{r.item}</dt>
                <dd class="font-mono text-[0.98rem] tabular-nums text-ink">{r.price}</dd>
              </div>
            ))}

            <div class="flex items-center justify-between gap-6 border-t border-border bg-bone py-5 px-2">
              <dt class="text-[1.02rem] font-medium text-ink">Total if you bought it standalone</dt>
              <dd class="font-mono text-[1.05rem] font-medium tabular-nums text-ink">$51,500</dd>
            </div>
            <div class="flex items-center justify-between gap-6 bg-bone py-5 px-2">
              <dt class="text-[1.05rem] font-medium text-ink">Inaugural cohort</dt>
              <dd class="font-mono text-[1.1rem] font-semibold tabular-nums text-ink">$20,000</dd>
            </div>
            <div class="flex items-center justify-between gap-6 bg-oxblood/5 py-5 px-2">
              <dt class="text-[1.05rem] font-semibold text-oxblood">You save</dt>
              <dd class="font-mono text-[1.2rem] font-semibold tabular-nums text-oxblood">$31,500</dd>
            </div>
          </dl>
        </div>
      </Card>

      <p class="mx-auto mt-8 max-w-[760px] text-center text-sm leading-relaxed text-ink-muted md:text-[0.95rem]">
        You can't actually buy most of these &agrave; la carte at the prices listed. The Spanish-speaking EA at $18,000 is the closest market price for what we deliver. The rest is what a vendor would charge a stranger off the street.
      </p>
    </ScrollReveal>
  </div>
</section>
