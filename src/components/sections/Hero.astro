---
import Button from '../ui/Button.astro';
import PillBadge from '../ui/PillBadge.astro';
import ScrollReveal from '../ui/ScrollReveal.astro';
---

<section class="relative overflow-hidden pt-16 md:pt-20 lg:pt-24">
  <!-- Subtle radial gradient backdrop -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 80% 60% at 30% 20%, #FAF7F1 0%, #F5F0E8 55%, #F5F0E8 100%);"
  />

  <div class="container-edge pb-20 md:pb-28 lg:pb-36">
    <div class="grid grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-12">
      <!-- Left: copy -->
      <ScrollReveal stagger class="flex flex-col gap-7 lg:col-span-7">
        <div class="reveal">
          <PillBadge tone="oxblood">Inaugural cohort &mdash; June 2026</PillBadge>
        </div>

        <h1
          class="reveal font-display text-ink text-balance"
          style="font-size: clamp(2.75rem, 6vw, 5.5rem); line-height: 1.02; font-variation-settings: 'opsz' 96, 'wght' 400; letter-spacing: -0.015em;"
        >
          The most expensive thing you haven't hedged is the country your family lives in.
        </h1>

        <p class="reveal text-lg leading-relaxed text-ink-muted text-pretty md:text-[1.2rem]">
          You diversify suppliers. You hedge currency. You structure your business across jurisdictions because that's how serious operators think. The country your family physically sleeps in at night is the one variable on your dashboard you haven't restructured. We restructure it.
        </p>

        <p class="reveal text-base leading-relaxed text-ink-muted md:text-[1.05rem]">
          Ninety days from your decision: family landed in Uruguay, residency filed, tax structure clean, apartment furnished, business uninterrupted. Built by a founder who just did this himself.
        </p>

        <div class="reveal flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-4">
          <Button href="#book" variant="primary" size="lg">
            Book your free diagnostic call <span aria-hidden="true">→</span>
          </Button>
          <Button href="#offer" variant="secondary" size="lg">
            How it works
          </Button>
        </div>

        <div class="reveal mt-3 flex items-center gap-3">
          <div class="flex" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg class="h-4 w-4 text-brass" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.77l-5.21 2.74.99-5.79-4.21-4.1 5.82-.85L10 1.5z" />
              </svg>
            ))}
          </div>
          <p class="text-sm italic text-ink-soft">
            Inaugural cohort. Eight founder families. June 2026.
          </p>
        </div>
      </ScrollReveal>

      <!-- Right: paired visual cards -->
      <ScrollReveal class="relative lg:col-span-5">
        <div class="relative mx-auto max-w-[460px]">
          <!-- Top tall card -->
          <div
            class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-border-soft bg-bone-deeper shadow-card"
          >
            <div
              aria-hidden="true"
              class="absolute inset-0"
              style="background: linear-gradient(140deg, #EDE6DA 0%, #D4CFC5 100%);"
            />
            <div class="absolute inset-0 flex flex-col justify-end p-6">
              <div class="rounded-xl bg-bone/85 px-4 py-3 backdrop-blur-sm">
                <p class="text-xs uppercase tracking-eyebrow text-ink-soft">Photo placeholder</p>
                <p class="mt-1 text-sm text-ink-muted">Montevideo doorway</p>
              </div>
            </div>
          </div>

          <!-- Bottom data card, overlapped -->
          <div
            class="relative -mt-16 ml-auto w-[78%] max-w-[320px] rounded-2xl border border-border-soft bg-bone-soft p-5 shadow-card"
          >
            <div class="flex items-center justify-between">
              <p class="text-[0.7rem] uppercase tracking-eyebrow text-ink-soft">
                Portfolio shift
              </p>
              <span class="rounded-full bg-bone-deeper px-2 py-0.5 text-[0.65rem] font-medium uppercase tracking-eyebrow text-ink-muted">
                90 days
              </span>
            </div>

            <div class="mt-4 h-24 w-full">
              <svg viewBox="0 0 200 80" class="h-full w-full" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="grad-up" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="#591C2A" stop-opacity="0.18" />
                    <stop offset="100%" stop-color="#591C2A" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <!-- Tax exposure: down -->
                <path d="M0 18 C 40 26, 80 36, 120 50 S 180 70, 200 72" stroke="#A47148" stroke-width="1.6" fill="none" />
                <!-- Optionality: up -->
                <path d="M0 62 C 40 56, 80 44, 120 30 S 180 14, 200 10" stroke="#591C2A" stroke-width="1.8" fill="none" />
                <path d="M0 62 C 40 56, 80 44, 120 30 S 180 14, 200 10 L 200 80 L 0 80 Z" fill="url(#grad-up)" />
              </svg>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-3 text-[0.7rem]">
              <div class="flex items-center gap-2">
                <span class="block h-2 w-2 rounded-full bg-brass"></span>
                <span class="text-ink-muted">Tax exposure</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="block h-2 w-2 rounded-full bg-oxblood"></span>
                <span class="text-ink-muted">Optionality</span>
              </div>
            </div>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </div>
</section>
