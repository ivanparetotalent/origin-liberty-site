---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PillBadge from '../../components/ui/PillBadge.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<Layout
  title="Blog — Origin Liberty"
  description="Notes from a founder who moved to Uruguay — taxes, residency, family logistics, and the math of jurisdiction."
>
  <section class="section-y">
    <div class="container-edge">
      <header class="mx-auto flex max-w-3xl flex-col items-center gap-5 text-center">
        <PillBadge>Notes</PillBadge>
        <h1
          class="font-display text-ink text-balance"
          style="font-size: clamp(2.25rem, 4.6vw, 3.75rem); line-height: 1.06; font-variation-settings: 'opsz' 96, 'wght' 380;"
        >
          Notes from the move.
        </h1>
        <p class="text-lg text-ink-muted text-pretty md:text-xl">
          Field notes on relocation, taxes, residency, family logistics, and the math of jurisdiction.
        </p>
      </header>

      {posts.length === 0 ? (
        <div class="mx-auto mt-16 max-w-2xl rounded-2xl border border-dashed border-border bg-bone-soft px-8 py-14 text-center">
          <p class="font-display text-2xl text-ink" style="font-variation-settings: 'opsz' 96, 'wght' 400;">
            No articles yet &mdash; check back soon.
          </p>
          <p class="mt-3 text-sm text-ink-muted">
            Want the first one in your inbox? Email
            <a href="mailto:hello@originliberty.com" class="text-oxblood underline-offset-4 hover:underline">
              hello@originliberty.com
            </a>.
          </p>
        </div>
      ) : (
        <ul class="mx-auto mt-16 grid max-w-4xl grid-cols-1 gap-8">
          {posts.map((post) => (
            <li class="group">
              <a
                href={`/blog/${post.slug}/`}
                class="block rounded-2xl border border-border-soft bg-bone-soft p-8 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-card"
              >
                <p class="text-xs uppercase tracking-eyebrow text-ink-soft">
                  {post.data.publishDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </p>
                <h2
                  class="mt-3 font-display text-2xl text-ink group-hover:text-oxblood md:text-3xl"
                  style="font-variation-settings: 'opsz' 96, 'wght' 420;"
                >
                  {post.data.title}
                </h2>
                <p class="mt-3 text-[1rem] leading-relaxed text-ink-muted">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Layout>
