---
const year = new Date().getFullYear();
---

<footer class="border-t border-border-soft bg-bone">
  <div class="container-edge py-12 md:py-16">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:items-center">
      <div class="flex md:justify-start">
        <a href="/" class="font-display text-[20px] text-ink" style="font-variation-settings: 'opsz' 144, 'wght' 380; letter-spacing: -0.01em;">
          Origin Liberty
        </a>
      </div>
      <p class="text-center text-sm text-ink-muted">
        Origin Liberty &middot; Montevideo, Uruguay
      </p>
      <div class="flex flex-col items-start gap-2 md:items-end">
        <a
          href="mailto:hello@originliberty.com"
          class="text-sm text-ink-muted underline-offset-4 hover:text-oxblood hover:underline"
        >
          hello@originliberty.com
        </a>
        <a href="/blog" class="text-sm text-ink-muted underline-offset-4 hover:text-oxblood hover:underline">
          Blog
        </a>
      </div>
    </div>

    <div class="mt-10 hairline"></div>
    <p class="mt-6 text-xs text-ink-soft">
      &copy; {year} Origin Liberty. All rights reserved.
    </p>
  </div>
</footer>
