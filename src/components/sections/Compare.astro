---
import SectionHeader from '../ui/SectionHeader.astro';
import ScrollReveal from '../ui/ScrollReveal.astro';
import Card from '../ui/Card.astro';

const cols = ['DIY', 'Local UY law firm', 'Nomad Capitalist', 'Origin Liberty'];

const rows = [
  { label: 'Price', values: ['"Free" + your time', '$1,500-$5,000', '$28,000+', '$20,000'] },
  { label: 'Time to landed', values: ['8-12+ months', '4-6 months', '12-month plan', '90 days'] },
  { label: 'Spanish-speaking coordinator', values: ['None', 'None', 'None', '6 months embedded'] },
  { label: 'U.S. tax structure', values: ['Hire separately', 'Not included', 'Generic', 'Vetted CPA partner'] },
  { label: 'Real estate + furniture', values: ['You manage 10 vendors', 'Not included', 'Concierge mentions', 'Done for you'] },
  { label: 'Founder-led', values: ['N/A', 'No', 'Yes (Andrew Henderson)', 'Yes (just-completed move)'] },
  { label: 'Network of relocated peers', values: ['None', 'None', 'Generic', 'Curated cohort'] },
  { label: 'Timeline guarantee', values: ['None', 'None', 'None', '25% back if 90 days missed'] },
];
---

<section class="section-y bg-bone">
  <div class="container-edge">
    <ScrollReveal class="mx-auto max-w-3xl">
      <SectionHeader eyebrow="Comparison" title="How this compares." />
    </ScrollReveal>

    <!-- Desktop: full table -->
    <ScrollReveal class="mx-auto mt-14 hidden max-w-6xl md:block">
      <Card variant="soft" padding="none" class="overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-border-soft">
                <th class="px-6 py-5 align-bottom"></th>
                {cols.map((c, i) => {
                  const highlight = i === cols.length - 1;
                  return (
                    <th
                      class={`px-6 py-5 align-bottom text-sm font-medium ${
                        highlight ? 'bg-oxblood/8 text-oxblood' : 'text-ink-muted'
                      }`}
                    >
                      <span class="block text-xs uppercase tracking-eyebrow">{c}</span>
                    </th>
                  );
                })}
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class="border-b border-border-soft last:border-b-0">
                  <th
                    scope="row"
                    class="px-6 py-5 text-left text-sm font-medium text-ink align-top"
                  >
                    {r.label}
                  </th>
                  {r.values.map((v, i) => {
                    const highlight = i === r.values.length - 1;
                    return (
                      <td
                        class={`px-6 py-5 align-top text-[0.95rem] ${
                          highlight
                            ? 'bg-oxblood/5 font-medium text-oxblood'
                            : 'text-ink-muted'
                        }`}
                      >
                        {v}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    </ScrollReveal>

    <!-- Mobile: stacked cards by competitor -->
    <ScrollReveal class="mt-12 flex flex-col gap-5 md:hidden">
      {cols.map((c, i) => {
        const highlight = i === cols.length - 1;
        return (
          <Card variant={highlight ? 'soft' : 'outline'} class={highlight ? 'ring-1 ring-oxblood/20' : ''}>
            <p class={`text-xs font-medium uppercase tracking-eyebrow ${highlight ? 'text-oxblood' : 'text-ink-soft'}`}>
              {c}
            </p>
            <dl class="mt-4 divide-y divide-border-soft">
              {rows.map((r) => (
                <div class="flex flex-col gap-1 py-3">
                  <dt class="text-xs font-medium uppercase tracking-eyebrow text-ink-soft">{r.label}</dt>
                  <dd class={`text-sm ${highlight ? 'font-medium text-oxblood' : 'text-ink'}`}>{r.values[i]}</dd>
                </div>
              ))}
            </dl>
          </Card>
        );
      })}
    </ScrollReveal>

    <ScrollReveal class="mx-auto mt-10 max-w-3xl text-center">
      <p class="text-base italic leading-relaxed text-ink-muted md:text-[1.05rem]">
        We are not the cheapest. We are not the broadest. We are the specialist who got it right.
      </p>
    </ScrollReveal>
  </div>
</section>
